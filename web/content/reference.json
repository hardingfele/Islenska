   "quiz": [
    {
     "q": "How is “hv” in hvað pronounced?",
     "opts": [
      "hw",
      "kv",
      "v",
      "f"
     ],
     "a": 1,
     "why": "hv is always kv: hvað ≈ kvath."
    },
    {
     "q": "Where does stress fall in Icelandic words?",
     "opts": [
      "Last syllable",
      "On the accented vowel",
      "First syllable",
      "It varies"
     ],
     "a": 2,
     "why": "Always the first syllable. Accents mark vowel quality, not stress."
    },
    {
     "q": "“ll” in fjall sounds most like…",
     "opts": [
      "l",
      "y",
      "tl",
      "dl"
     ],
     "a": 2,
     "why": "ll is a tl-like sound: fjatl."
    },
    {
     "q": "Which letter never starts a word?",
     "opts": [
      "þ",
      "ð",
      "æ",
      "ö"
     ],
     "a": 1,
     "why": "ð only appears in the middle or end of words."
    },
    {
     "q": "“á” sounds like…",
     "opts": [
      "a in father",
      "ow in cow",
      "ay in day",
      "aw in saw"
     ],
     "a": 1,
     "why": "á = ow, as in cow: já ≈ yow."
    }
   ]

 "grammar": [
  {
   "id": "sounds",
   "title": "1 · Letters & sounds",
   "intro": "Icelandic spelling is very regular once you know a few rules. The accent marks don't mean stress — stress is always on the first syllable. They mark different vowels.",
   "tables": [

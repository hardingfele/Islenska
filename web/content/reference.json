       "th in “think”",
       "þrír"
      ],
      [
       "ð",
       "th in “this” (never at word start)",
       "góður"
      ],
      [
       "á",
       "ow in “cow”",
       "já"
      ],
      [
       "é",
       "ye in “yes”",
       "ég"
      ],
      [
       "í / ý",
       "ee in “see”",
       "níu"
      ],
      [

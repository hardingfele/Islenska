  {
   "id": "vera",
   "title": "2 · Pronouns & “að vera” (to be)",
   "intro": "Icelandic has three genders for “they”: þeir (all men / masculine), þær (all women / feminine) and þau (mixed group or neuter). “Það” means “it” and is also used like English “there/it” (Það er kalt — It's cold).",
   "tables": [
    {
     "caption": "að vera — to be (present)",
     "head": [
      "Person",
      "Pronoun",
      "Verb"
     ],
     "rows": [
      [
       "I",
       "ég",
       "er"
      ],
      [
       "you (one)",
       "þú",
       "ert"
      ],
      [
       "he / she / it",
       "hann / hún / það",
       "er"
      ],
      [
       "we",
       "við",
       "erum"
      ],
      [
       "you (several)",
       "þið",
       "eruð"
      ],
      [
       "they",
       "þeir / þær / þau",
       "eru"
      ]
     ]
    }
   ],
   "examples": [
    {
     "is": "Ég er þreyttur.",
     "en": "I am tired."
    },
    {
     "is": "Hún er í Reykjavík.",
     "en": "She is in Reykjavík."
    },
    {
     "is": "Við erum frá Ameríku.",
     "en": "We are from America."
    },
    {
     "is": "Þau eru heima.",
     "en": "They are at home."
    },
    {
     "is": "Ert þú Íslendingur?",
     "en": "Are you Icelandic?"
    }
   ],
   "quiz": [
    {
     "q": "Við ___ glaðir.",
     "opts": [
      "er",
      "erum",
      "eru",
      "eruð"
     ],
     "a": 1,
     "why": "við → erum."
    },
    {
     "q": "A mixed group of a man and a woman is…",
     "opts": [
      "þeir",
      "þær",
      "þau",
      "þið"
     ],
     "a": 2,
     "why": "Mixed groups use the neuter plural þau."
    },
    {
     "q": "Þú ___ góður kennari.",
     "opts": [
      "ert",
      "er",
      "eruð",
      "erum"
     ],
     "a": 0,
     "why": "þú → ert."
    },
    {
     "q": "“Það er kalt” means…",
     "opts": [
      "He is cold",
      "It is cold",
      "That is a cold",
      "They are cold"
     ],
     "a": 1,
     "why": "Það is used for weather and general statements."
    }
